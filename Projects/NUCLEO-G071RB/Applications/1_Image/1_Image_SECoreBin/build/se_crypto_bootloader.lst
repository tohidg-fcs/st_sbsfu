 226:Src/se_crypto_bootloader.c ****   {
 227:Src/se_crypto_bootloader.c ****     SE_ReadKey_2(&(m_aSE_FirmwareKey[0]));
 228:Src/se_crypto_bootloader.c ****   }
 229:Src/se_crypto_bootloader.c **** #endif  /* (NB_FW_IMAGES > 1) */
 230:Src/se_crypto_bootloader.c **** #if (SFU_NB_MAX_ACTIVE_IMAGE > 2U)
 231:Src/se_crypto_bootloader.c ****   else if (memcmp(pxSE_Metadata->SFUMagic, SFUM_3, strlen(SFUM_3)) == 0)
 232:Src/se_crypto_bootloader.c ****   {
 233:Src/se_crypto_bootloader.c ****     SE_ReadKey_3(&(m_aSE_FirmwareKey[0]));
 234:Src/se_crypto_bootloader.c ****   }
 235:Src/se_crypto_bootloader.c **** #endif  /* (NB_FW_IMAGES > 2) */
 236:Src/se_crypto_bootloader.c ****   else
 237:Src/se_crypto_bootloader.c ****   {
 238:Src/se_crypto_bootloader.c ****     /* nothing to do */
 239:Src/se_crypto_bootloader.c ****     ;
 240:Src/se_crypto_bootloader.c ****   }
 241:Src/se_crypto_bootloader.c **** }
