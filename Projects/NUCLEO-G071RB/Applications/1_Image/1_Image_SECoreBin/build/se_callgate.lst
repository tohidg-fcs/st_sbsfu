 256:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****   {
 257:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****     /* If an interrupt is being handled, then no service is allowed */
