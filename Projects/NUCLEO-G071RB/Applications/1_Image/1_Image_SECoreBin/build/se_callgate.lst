 473:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****        * This is implemented in the SE_CRYPTO_Decrypt_Init code.
ARM GAS  /tmp/ccksLSA3.s 			page 37


 474:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****        */
