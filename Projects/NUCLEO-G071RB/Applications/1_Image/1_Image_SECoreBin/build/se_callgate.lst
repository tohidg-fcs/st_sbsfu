ARM GAS  /tmp/ccksLSA3.s 			page 8


 268:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****     AppliActiveSpMode = (__get_CONTROL() >> 1UL) & 0x00000001UL;
 269:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****   }
 270:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****   else /* An exit interrupt service is requested */
 271:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****   {
 272:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****     /* Whereas there is no interrupt handling on going */
 273:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****     if (IntHand != 1UL)
 274:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****     {
 275:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****       *peSE_Status = SE_OK;
 276:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****       EXIT_PROTECTED_AREA();
 277:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****       return SE_ERROR;
 278:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****     }
 279:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c **** 
 280:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****     /* Requested service = SE_EXIT_INTERRUPT,
 281:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****     so we should be in Handler Mode,
 282:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****     and so, current SP mode should be MSP
 283:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****     */
 284:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****     if (((__get_CONTROL() >> 1UL) & 0x00000001UL) != 0x00000000UL)
 285:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****     {
 286:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****       *peSE_Status = SE_BUSY;
 287:../../../../..//Middlewares/ST/STM32_Secure_Engine/Core/se_callgate.c ****       EXIT_PROTECTED_AREA();
