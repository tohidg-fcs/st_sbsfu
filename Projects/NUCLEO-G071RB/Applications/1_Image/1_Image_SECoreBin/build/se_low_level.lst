 388:../../../../..//Drivers/CMSIS/Include/cmsis_gcc.h ****     result |= value & 1U;
 389:../../../../..//Drivers/CMSIS/Include/cmsis_gcc.h ****     s--;
 390:../../../../..//Drivers/CMSIS/Include/cmsis_gcc.h ****   }
