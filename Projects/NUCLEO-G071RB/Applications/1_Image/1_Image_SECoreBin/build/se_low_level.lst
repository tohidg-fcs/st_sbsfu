 347:../../../../..//Drivers/CMSIS/Include/cmsis_gcc.h **** {
 348:../../../../..//Drivers/CMSIS/Include/cmsis_gcc.h ****   op2 %= 32U;
 349:../../../../..//Drivers/CMSIS/Include/cmsis_gcc.h ****   if (op2 == 0U)
