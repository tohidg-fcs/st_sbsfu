 501:Src/se_low_level.c **** __attribute__((always_inline)) __STATIC_INLINE uint32_t get_LR(void)
 502:Src/se_low_level.c **** {
 503:Src/se_low_level.c ****   register uint32_t result;
 504:Src/se_low_level.c **** 
 505:Src/se_low_level.c **** #if defined ( __ICCARM__ ) || defined ( __GNUC__ ) || defined (__ARMCC_VERSION)
 506:Src/se_low_level.c ****   __ASM volatile("MOV %0, LR" : "=r"(result));
 507:Src/se_low_level.c **** #elif defined ( __CC_ARM )
 508:Src/se_low_level.c ****   __ASM volatile("MOV result, __return_address()");
 509:Src/se_low_level.c **** #endif /* ( __ICCARM__ ) || ( __GNUC__ ) */
