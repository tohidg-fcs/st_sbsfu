 319:Src/se_low_level.c **** /**
 320:Src/se_low_level.c ****   * @brief Check if an array is inside the RAM of the product
 321:Src/se_low_level.c ****   * @param Addr : address  of array
 322:Src/se_low_level.c ****   * @param Length : length of array in byte
 323:Src/se_low_level.c ****   */
 324:Src/se_low_level.c **** SE_ErrorStatus SE_LL_Buffer_in_ram(void *pBuff, uint32_t Length)
 325:Src/se_low_level.c **** {
 326:Src/se_low_level.c ****   SE_ErrorStatus e_ret_status;
 327:Src/se_low_level.c ****   uint32_t addr_start = (uint32_t)pBuff;
 328:Src/se_low_level.c ****   uint32_t addr_end = addr_start + Length - 1U;
 329:Src/se_low_level.c **** 
 330:Src/se_low_level.c ****   /* Check if length is positive with no overflow */
 331:Src/se_low_level.c ****   if ((Length != 0U) && (!((0xFFFFFFFFUL - addr_start) < Length))
 332:Src/se_low_level.c ****       && ((addr_end  <= SB_REGION_RAM_END) && (addr_start >= (SE_REGION_RAM_END + 1U))))
 333:Src/se_low_level.c ****   {
 334:Src/se_low_level.c ****     e_ret_status = SE_SUCCESS;
 335:Src/se_low_level.c ****   }
 336:Src/se_low_level.c ****   else
 337:Src/se_low_level.c ****   {
 338:Src/se_low_level.c ****     e_ret_status = SE_ERROR;
 339:Src/se_low_level.c **** 
 340:Src/se_low_level.c ****     /* Could be an attack ==> Reset */
 341:Src/se_low_level.c ****     NVIC_SystemReset();
 342:Src/se_low_level.c ****   }
 343:Src/se_low_level.c ****   return e_ret_status;
 344:Src/se_low_level.c **** }
