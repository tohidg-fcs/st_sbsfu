 269:Src/se_low_level.c ****         ((source + Length) <= (SlotHeaderAdd[SLOT_ACTIVE_1 + i] + SFU_IMG_IMAGE_OFFSET)))
 270:Src/se_low_level.c ****     {
 271:Src/se_low_level.c ****       verified = 1U;
 272:Src/se_low_level.c ****     }
