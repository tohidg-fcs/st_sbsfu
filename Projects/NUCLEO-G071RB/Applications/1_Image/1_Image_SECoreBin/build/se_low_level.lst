 279:Src/se_low_level.c ****   }
 280:Src/se_low_level.c **** 
 281:Src/se_low_level.c ****   SE_DoubleECC_Error_Counter = 0U;
 282:Src/se_low_level.c ****   /* Do not use memcpy from lib : ECC error should be checked at each loop */
