 514:Src/se_low_level.c **** /*
 515:Src/se_low_level.c ****    As this handler code relies on stack pointer position to manipulate the PC return value, it is i
 516:Src/se_low_level.c ****    not to use extra registers (on top of scratch registers), because it would change the stack poin
 517:Src/se_low_level.c ****    position. Then compiler optimizations are customized to ensure that.
 518:Src/se_low_level.c **** */
 519:Src/se_low_level.c **** #if defined(__ICCARM__)
 520:Src/se_low_level.c **** #pragma optimize=none
 521:Src/se_low_level.c **** #elif defined(__CC_ARM)
 522:Src/se_low_level.c **** #pragma O0
