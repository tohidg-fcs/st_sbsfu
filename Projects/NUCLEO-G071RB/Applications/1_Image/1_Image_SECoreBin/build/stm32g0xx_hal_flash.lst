 373:../../../../..//Drivers/CMSIS/Include/cmsis_gcc.h **** __STATIC_FORCEINLINE uint32_t __RBIT(uint32_t value)
 374:../../../../..//Drivers/CMSIS/Include/cmsis_gcc.h **** {
