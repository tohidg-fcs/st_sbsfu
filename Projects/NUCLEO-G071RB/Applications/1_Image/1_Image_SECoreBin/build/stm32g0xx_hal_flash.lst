 733:../../../../..//Drivers/CMSIS/Include/cmsis_gcc.h **** {
 734:../../../../..//Drivers/CMSIS/Include/cmsis_gcc.h ****   if (sat <= 31U)
 735:../../../../..//Drivers/CMSIS/Include/cmsis_gcc.h ****   {
