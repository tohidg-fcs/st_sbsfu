 585:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c **** /**
 586:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   * @brief  Wait for a FLASH operation to complete.
 587:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   * @param  Timeout maximum flash operation timeout
 588:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   * @retval HAL_StatusTypeDef HAL Status
 589:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   */
 590:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c **** HAL_StatusTypeDef FLASH_WaitForLastOperation(uint32_t Timeout)
 591:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c **** {
 592:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   uint32_t error;
 593:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   /* Wait for the FLASH operation to complete by polling on BUSY flag to be reset.
 594:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****      Even if the FLASH operation fails, the BUSY flag will be reset and an error
 595:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****      flag will be set */
 596:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   uint32_t timeout = HAL_GetTick() + Timeout;
 597:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c **** 
 598:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   /* Wait if any operation is ongoing */
 599:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c **** #if defined(FLASH_DBANK_SUPPORT)
 600:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   error = (FLASH_SR_BSY1 | FLASH_SR_BSY2);
 601:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c **** #else
 602:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   error = FLASH_SR_BSY1;
ARM GAS  /tmp/ccW7HcuX.s 			page 12


 603:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c **** #endif /* FLASH_DBANK_SUPPORT */
 604:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c **** 
 605:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   while ((FLASH->SR & error) != 0x00U)
 606:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   {
 607:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****     if (HAL_GetTick() >= timeout)
 608:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****     {
 609:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****       return HAL_TIMEOUT;
 610:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****     }
 611:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   }
 612:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c **** 
 613:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   /* check flash errors */
 614:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   error = (FLASH->SR & FLASH_SR_ERRORS);
 615:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c **** 
 616:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   /* Clear SR register */
 617:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   FLASH->SR = FLASH_SR_CLEAR;
 618:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c **** 
 619:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   if (error != 0x00U)
 620:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   {
 621:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****     /*Save the error code*/
 622:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****     pFlash.ErrorCode = error;
 623:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****     return HAL_ERROR;
 624:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   }
 625:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c **** 
 626:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   /* Wait for control register to be written */
 627:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   timeout = HAL_GetTick() + Timeout;
 628:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c **** 
 629:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   while ((FLASH->SR & FLASH_SR_CFGBSY) != 0x00U)
 630:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   {
 631:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****     if (HAL_GetTick() >= timeout)
 632:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****     {
 633:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****       return HAL_TIMEOUT;
 634:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****     }
 635:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   }
 636:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c **** 
 637:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c ****   return HAL_OK;
 638:../../../../..//Drivers/STM32G0xx_HAL_Driver/Src/stm32g0xx_hal_flash.c **** }
